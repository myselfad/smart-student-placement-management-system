generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum DriveStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  ASSESSMENT
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  SELECTED
  REJECTED
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  role             Role             @default(STUDENT)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  
  studentProfile   StudentProfile?
  createdDrives    PlacementDrive[] @relation("DriveCreator")
  statusChanges    ApplicationStatusHistory[] @relation("StatusChanger")
  notifications    Notification[]   @relation("NotificationRecipient")
  announcements    Announcement[]   @relation("AnnouncementCreator")
}

model StudentProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  fullName             String
  phone                String?
  branch               String?
  yearOfStudy          Int?
  graduationYear       Int?
  cgpa                 Float?
  backlogCount         Int?     @default(0)
  profileCompletionPct Int      @default(0)
  updatedAt            DateTime @updatedAt
  
  resumes              Resume[]
  studentSkills        StudentSkill[]
  projects             Project[]
  certifications       Certification[]
  achievements         Achievement[]
  experiences          Experience[]
  applications         Application[]
}

model Resume {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  fileUrl          String
  fileName         String
  isCurrent        Boolean        @default(true)
  uploadedAt       DateTime       @default(now())
  
  applications     Application[]
}

model Skill {
  id               String         @id @default(uuid())
  name             String         @unique
  studentSkills    StudentSkill[]
  requiredSkills   RequiredSkill[]
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id])

  @@unique([studentProfileId, skillId])
}

model Project {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  title            String
  description      String
  techStack        String
  link             String?
}

model Certification {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  title            String
  issuer           String
  issueDate        DateTime
  credentialUrl    String?
}

model Achievement {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  title            String
  description      String
  date             DateTime?
}

model Experience {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  title            String
  company          String
  description      String
  startDate        DateTime
  endDate          DateTime?
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  industry    String?
  logoUrl     String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  drives      PlacementDrive[]
}

model PlacementDrive {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  title              String
  description        String
  location           String
  compensation       String
  jobType            String
  selectionProcess   String?  // Can be JSON or text
  openings           Int
  applicationDeadline DateTime
  status             DriveStatus @default(DRAFT)
  createdByUserId    String
  createdBy          User     @relation("DriveCreator", fields: [createdByUserId], references: [id])
  createdAt          DateTime @default(now())

  eligibilityCriteria EligibilityCriteria?
  requiredSkills      RequiredSkill[]
  applications        Application[]
}

model EligibilityCriteria {
  id                     String   @id @default(uuid())
  driveId                String   @unique
  drive                  PlacementDrive @relation(fields: [driveId], references: [id])
  minCgpa                Float?
  allowedBranches        String[] // Array of branch strings
  maxBacklogs            Int?
  allowedGraduationYears Int[]    // Array of years
  locked                 Boolean  @default(false)
}

model RequiredSkill {
  id          String         @id @default(uuid())
  driveId     String
  drive       PlacementDrive @relation(fields: [driveId], references: [id])
  skillId     String
  skill       Skill          @relation(fields: [skillId], references: [id])

  @@unique([driveId, skillId])
}

model Application {
  id               String   @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  driveId          String
  drive            PlacementDrive @relation(fields: [driveId], references: [id])
  status           ApplicationStatus @default(APPLIED)
  resumeId         String
  resume           Resume @relation(fields: [resumeId], references: [id])
  appliedAt        DateTime @default(now())

  statusHistory    ApplicationStatusHistory[]

  @@unique([studentProfileId, driveId])
}

model ApplicationStatusHistory {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedByUserId String
  changedBy     User     @relation("StatusChanger", fields: [changedByUserId], references: [id])
  changedAt     DateTime @default(now())
  note          String?
}

model Notification {
  id                String   @id @default(uuid())
  recipientId       String
  recipient         User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  type              String   // e.g., 'DRIVE_PUBLISHED', 'STATUS_CHANGE', 'ANNOUNCEMENT'
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Announcement {
  id             String   @id @default(uuid())
  title          String
  body           String
  audienceFilter String   // JSON string of filters (branch, year, drive)
  createdByUserId String
  createdBy      User     @relation("AnnouncementCreator", fields: [createdByUserId], references: [id])
  createdAt      DateTime @default(now())
}
