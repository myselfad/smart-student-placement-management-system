# ==============================================================================
# SSPMS API Environment Variables (Production & Local)
# ==============================================================================

# Database Connection (PostgreSQL - Supabase / Neon / Render Postgres)
# Supabase Pooled (Port 5432 / 6543): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/sspms?sslmode=require"

# JWT Secret for Authentication (min 32 characters, e.g. `openssl rand -hex 32`)
JWT_SECRET="your_super_secret_jwt_key_here"

# Frontend URL for CORS (Comma-separated if multiple, e.g. https://smart-student-placement-management.vercel.app)
FRONTEND_URL="https://smart-student-placement-management.vercel.app"

# Server Port (Render sets this automatically)
PORT=4000

# Connection pool size (default: 10)
DB_POOL_SIZE=10

# Optional: Supabase Storage for persistent resume uploads
# STORAGE_PROVIDER="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="resumes"

# Optional: Custom Initial Admin for Seed Script
# ADMIN_INITIAL_EMAIL="admin@sspms.edu"
# ADMIN_INITIAL_PASSWORD="YourSecurePassword123!"
