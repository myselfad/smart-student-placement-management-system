# ==============================================================================
# SSPMS Environment Variables (Production & Local)
# ==============================================================================

# Database Connection (PostgreSQL)
# For production, use a managed provider like Supabase or Neon.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://user:password@host:5432/sspms"

# JWT Secret for Authentication
# Generate a strong random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET="your_super_secret_jwt_key_here"

# Frontend URL for CORS (Backend needs to know who to allow)
# Local: http://localhost:5173
# Production: https://your-vercel-domain.vercel.app
FRONTEND_URL="http://localhost:5173"

# Port (Optional, Vercel dynamically sets this)
PORT=4000
